// Tuktak Bazaar — single-vendor e-commerce schema.
// Money is stored as whole taka (Int). Orders snapshot prices and addresses.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  CUSTOMER
  // Staff work in the admin panel with the permissions listed on their account
  STAFF
  // Owners: every permission, plus staff management and the audit log
  ADMIN
}

/// Areas of the admin panel a STAFF account may use.
enum Permission {
  CATALOG
  ORDERS
  MARKETING
  SUPPORT
  REPORTS
  SETTINGS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  DELIVERY_FAILED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum DeliveryZone {
  INSIDE_DHAKA
  DHAKA_SUBURBS
  OUTSIDE_DHAKA
}

enum VoucherType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum RefundMethod {
  ORIGINAL
  COINS
}

enum MovementReason {
  ORDER
  CANCEL
  RETURN
  RESTOCK
  ADJUSTMENT
  DELIVERY_FAILED
}

enum CoinReason {
  CHECK_IN
  ORDER_REWARD
  REVIEW_REWARD
  REDEEM
  REFUND
  ADJUSTMENT
  CAMPAIGN_REWARD
}

enum BannerPlacement {
  HOME_HERO
  HOME_STRIP
}

enum CampaignTheme {
  MEGA_SALE
  PAYDAY
  EID
  BOISHAKH
  PUJA
  WINTER
}

enum GameStyle {
  MYSTERY_BOX
  SPIN_WHEEL
}

enum RewardKind {
  VOUCHER
  COINS
  NONE
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ShipmentState {
  BOOKED
  IN_TRANSIT
  DELIVERED
  PARTIAL
  RETURNED
  CANCELLED
}

enum AlertType {
  PRICE_DROP
  BACK_IN_STOCK
}

/// OPEN waits on staff, PENDING waits on the customer.
enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

enum TicketCategory {
  ORDER_ISSUE
  DELIVERY
  PAYMENT
  RETURN_REFUND
  PRODUCT
  ACCOUNT
  OTHER
}

enum TicketPriority {
  NORMAL
  HIGH
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String
  phone         String       @unique
  email         String?      @unique
  passwordHash  String?
  role          Role         @default(CUSTOMER)
  permissions   Permission[] @default([])
  coins         Int          @default(0)
  codBlocked    Boolean      @default(false)
  isActive      Boolean      @default(true)
  // SMS reminders and alerts (order updates and login codes are always sent)
  marketingSms  Boolean      @default(true)
  lastCheckInAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  addresses     Address[]
  cart          Cart?
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
  questions     Question[]
  returns       ReturnRequest[]
  coinTxns      CoinTransaction[]
  notifications Notification[]
  vouchers      UserVoucher[]
  redemptions   VoucherRedemption[]
  alerts        ProductAlert[]
  tickets       SupportTicket[]     @relation("TicketCustomer")
  assigned      SupportTicket[]     @relation("TicketAssignee")
  ticketPosts   TicketMessage[]
  auditLogs     AuditLog[]
  campaignPlays CampaignPlay[]
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  phone     String
  division  String
  district  String
  area      String
  line      String
  label     String   @default("Home")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id        String  @id @default(cuid())
  name      String
  nameBn    String?
  slug      String  @unique
  parentId  String?
  icon      String?
  imageUrl  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @default("") @db.Text
  highlights  String[]      @default([])
  brandId     String?
  categoryId  String
  status      ProductStatus @default(ACTIVE)
  // e.g. ["Color", "Storage"]; each variant's `options` maps these names to values
  optionNames String[]      @default([])
  // [{ "name": "RAM", "value": "8 GB" }]
  specs       Json          @default("[]")
  // Extra search terms: Bangla, Banglish and common misspellings
  keywords    String        @default("")
  warranty    String?
  returnDays  Int           @default(7)
  weightGrams Int           @default(500)
  ratingAvg   Float         @default(0)
  ratingCount Int           @default(0)
  soldCount   Int           @default(0)
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand     Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category  Category         @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  variants  ProductVariant[]
  reviews   Review[]
  questions Question[]
  wishlist  WishlistItem[]
  alerts    ProductAlert[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  // { "Color": "Black", "Storage": "128 GB" }
  options           Json     @default("{}")
  price             Int
  salePrice         Int?
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  flashItems FlashSaleItem[]
  movements  InventoryMovement[]
  alerts     ProductAlert[]
  campaigns  CampaignProduct[]

  @@index([productId])
}

// ───────────────────────── Inventory ─────────────────────────

model InventoryMovement {
  id          String         @id @default(cuid())
  variantId   String
  delta       Int
  reason      MovementReason
  note        String?
  refId       String?
  createdById String?
  createdAt   DateTime       @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

// ───────────────────────── Shopping ─────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  updatedAt  DateTime   @updatedAt
  // Last abandoned-cart reminder; a new one waits for fresh cart activity
  remindedAt DateTime?
  items      CartItem[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  selected  Boolean  @default(true)
  addedAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ───────────────────────── Promotions ─────────────────────────

model Voucher {
  id            String      @id @default(cuid())
  code          String      @unique
  title         String
  description   String?
  type          VoucherType
  // percent (1–100) for PERCENT, taka for FIXED, ignored for FREE_SHIPPING
  value         Int         @default(0)
  maxDiscount   Int?
  minSpend      Int         @default(0)
  startsAt      DateTime
  endsAt        DateTime
  usageLimit    Int?
  perUserLimit  Int         @default(1)
  usedCount     Int         @default(0)
  isActive      Boolean     @default(true)
  // Shown on product and cart pages for customers to collect
  isCollectible Boolean     @default(false)
  createdAt     DateTime    @default(now())

  collectedBy UserVoucher[]
  redemptions VoucherRedemption[]
  campaigns   Campaign[]
  rewards     CampaignReward[]
}

model UserVoucher {
  id          String   @id @default(cuid())
  userId      String
  voucherId   String
  collectedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId])
}

model VoucherRedemption {
  id         String    @id @default(cuid())
  voucherId  String
  userId     String
  orderId    String    @unique
  discount   Int
  createdAt  DateTime  @default(now())
  reversedAt DateTime?

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([voucherId, userId])
}

model FlashSale {
  id        String          @id @default(cuid())
  title     String
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean         @default(true)
  items     FlashSaleItem[]
  campaigns Campaign[]

  @@index([startsAt, endsAt])
}

model FlashSaleItem {
  id            String @id @default(cuid())
  flashSaleId   String
  variantId     String
  flashPrice    Int
  quantityLimit Int
  soldQty       Int    @default(0)
  perUserLimit  Int    @default(2)

  flashSale  FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([flashSaleId, variantId])
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  link      String          @default("/")
  placement BannerPlacement @default(HOME_HERO)
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNo          String        @unique
  userId           String
  status           OrderStatus
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(UNPAID)
  subtotal         Int
  shippingFee      Int
  shippingDiscount Int           @default(0)
  discount         Int           @default(0)
  coinsUsed        Int           @default(0)
  total            Int
  voucherId        String?
  voucherCode      String?
  shipName         String
  shipPhone        String
  shipDivision     String
  shipDistrict     String
  shipArea         String
  shipLine         String
  zone             DeliveryZone
  note             String?
  riskScore        Int           @default(0)
  needsCall        Boolean       @default(false)
  courier          String?
  trackingNo       String?
  expiresAt        DateTime?
  coinsAwarded     Boolean       @default(false)
  placedAt         DateTime      @default(now())
  confirmedAt      DateTime?
  packedAt         DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user       User               @relation(fields: [userId], references: [id])
  items      OrderItem[]
  events     OrderEvent[]
  payments   Payment[]
  returns    ReturnRequest[]
  redemption VoucherRedemption?
  shipments  Shipment[]
  tickets    SupportTicket[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([shipPhone])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  variantId       String
  title           String
  variantLabel    String?
  imageUrl        String?
  unitPrice       Int
  originalPrice   Int
  quantity        Int
  lineTotal       Int
  flashSaleItemId String?
  reviewed        Boolean @default(false)

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  flashItem FlashSaleItem?  @relation(fields: [flashSaleItemId], references: [id], onDelete: SetNull)
  returns   ReturnRequest[]
  review    Review?

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  status    OrderStatus?
  title     String
  note      String?
  // "system", "customer" or "admin"
  actor     String       @default("system")
  // The staff member, when actor is "admin"
  actorId   String?
  actorName String?
  // Staff-only entries (notes, courier exceptions) never reach the customer
  internal  Boolean      @default(false)
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  // "cod", "mock" or "sslcommerz"
  provider       String
  amount         Int
  status         PaymentStatus @default(PENDING)
  idempotencyKey String        @unique
  sessionKey     String?
  providerTxnId  String?
  valId          String?
  raw            Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, provider])
}

// ───────────────────────── After-sale ─────────────────────────

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  orderItemId  String
  userId       String
  quantity     Int
  reason       String
  details      String?
  images       String[]     @default([])
  status       ReturnStatus @default(REQUESTED)
  refundAmount Int?
  refundMethod RefundMethod @default(ORIGINAL)
  restock      Boolean      @default(true)
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  userId      String
  orderItemId String       @unique
  rating      Int
  comment     String       @default("")
  images      String[]     @default([])
  status      ReviewStatus @default(PUBLISHED)
  reply       String?
  repliedAt   DateTime?
  createdAt   DateTime     @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
}

model Question {
  id          String    @id @default(cuid())
  productId   String
  userId      String
  question    String
  answer      String?
  answeredAt  DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

// ───────────────────────── Engagement ─────────────────────────

model CoinTransaction {
  id        String     @id @default(cuid())
  userId    String
  amount    Int
  reason    CoinReason
  note      String?
  refId     String?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ───────────────────────── Config ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SearchSynonym {
  id       String   @id @default(cuid())
  term     String   @unique
  synonyms String[]
}

// ───────────────────────── Couriers ─────────────────────────

/// One consignment booked with a courier for an order.
model Shipment {
  id            String        @id @default(cuid())
  orderId       String
  // "steadfast", "pathao", "redx" or "test"
  courier       String
  consignmentId String
  trackingCode  String
  state         ShipmentState @default(BOOKED)
  // The courier's own status text, as last reported
  courierStatus String?
  codAmount     Int
  deliveryFee   Int?
  note          String?
  raw           Json?
  lastEventAt   DateTime?
  lastSyncAt    DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@unique([courier, consignmentId])
  @@index([orderId])
  @@index([state, lastSyncAt])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  message    String?
  // "booking", "webhook", "sync" or "staff"
  source     String
  // Stops a retried webhook from being applied twice
  dedupeKey  String?  @unique
  raw        Json?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

// ───────────────────────── Alerts and messages ─────────────────────────

/// "Tell me when it's back" and "tell me if the price drops", per variant.
model ProductAlert {
  id               String    @id @default(cuid())
  userId           String
  productId        String
  variantId        String
  type             AlertType
  // Price the customer saw when subscribing (price-drop alerts)
  priceAtSubscribe Int?
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId, type])
  @@index([type, notifiedAt])
}

/// Every SMS the store sends or would send (SMS_PROVIDER=console only logs).
model SmsLog {
  id          String   @id @default(cuid())
  phone       String
  body        String
  // "otp", "alert", "cart", "ticket" ...
  kind        String
  provider    String
  // "sent", "failed" or "logged"
  status      String
  error       String?
  providerRef String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([phone, createdAt])
}

// ───────────────────────── Support ─────────────────────────

model SupportTicket {
  id            String         @id @default(cuid())
  ticketNo      String         @unique
  userId        String
  orderId       String?
  category      TicketCategory
  subject       String
  status        TicketStatus   @default(OPEN)
  priority      TicketPriority @default(NORMAL)
  assigneeId    String?
  lastMessageAt DateTime       @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User            @relation("TicketCustomer", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, createdAt])
  @@index([assigneeId, status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  fromStaff Boolean
  body      String   @db.Text
  images    String[] @default([])
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────────────────── Audit ─────────────────────────

/// One row per change made from the admin panel.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  actorRole Role?
  // e.g. "order.transition", "product.update"
  action    String
  entity    String?
  entityId  String?
  summary   String
  method    String
  path      String
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

// ───────────────────────── Promo campaigns ─────────────────────────
// A campaign is a dated, themed promotion shown on the home page right before "Shop by category",
// with an offer strip under the header on every store page. All customer-facing text is Bangla.

model Campaign {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  tagline      String?
  theme        CampaignTheme @default(MEGA_SALE)
  heroImageUrl String?
  ctaLabel     String        @default("এখনই কিনুন")
  ctaHref      String        @default("/flash-sale")
  startsAt     DateTime
  endsAt       DateTime
  // The banner shows "শুরু হতে বাকি" this many hours before startsAt (0–168)
  teaserHours  Int           @default(24)
  // When several campaigns overlap, the highest priority is shown
  priority     Int           @default(0)
  confetti     Boolean       @default(true)
  gameEnabled  Boolean       @default(false)
  gameStyle    GameStyle     @default(MYSTERY_BOX)
  isActive     Boolean       @default(true)
  voucherId    String?
  flashSaleId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  voucher   Voucher?             @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  flashSale FlashSale?           @relation(fields: [flashSaleId], references: [id], onDelete: SetNull)
  products  CampaignProduct[]
  ticker    CampaignTickerItem[]
  rewards   CampaignReward[]
  plays     CampaignPlay[]

  @@index([isActive, startsAt, endsAt])
}

// Hand-picked deals, shown at the customer's normal price (sale price if any)
model CampaignProduct {
  id         String @id @default(cuid())
  campaignId String
  variantId  String
  sortOrder  Int    @default(0)

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([campaignId, variantId])
}

model CampaignTickerItem {
  id         String  @id @default(cuid())
  campaignId String
  text       String
  href       String?
  sortOrder  Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
}

model CampaignReward {
  id         String     @id @default(cuid())
  campaignId String
  kind       RewardKind
  voucherId  String?
  coins      Int?
  label      String
  // Relative odds; the chance is weight / sum of weights of rewards still in stock
  weight     Int
  // null = unlimited
  stock      Int?
  givenCount Int        @default(0)
  // Order of the segments on the spin wheel
  sortOrder  Int        @default(0)

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  voucher  Voucher?       @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  plays    CampaignPlay[]

  @@index([campaignId, sortOrder])
}

// One play per customer per campaign per Dhaka day
model CampaignPlay {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  // "YYYY-MM-DD" in Asia/Dhaka, so the game resets at midnight Dhaka time
  playDay    String
  rewardId   String?
  createdAt  DateTime @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward   CampaignReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId, playDay])
  @@index([campaignId, playDay])
}
